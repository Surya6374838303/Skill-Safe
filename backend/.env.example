# SkillSafe Backend Configuration Template
# Copy to .env and configure for your environment

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Connection (Default SQLite for local demo, change to postgresql for production)
DATABASE_URL=sqlite:///./skillsafe.db
# DATABASE_URL=postgresql://user:password@localhost:5432/skillsafe_db

# Security & JWT Tokens (Generate random 32-byte secret in production)
JWT_SECRET_KEY=dev_insecure_secret_key_change_in_production_sih2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Hardware Gateway Settings
MAX_ALLOWABLE_GAS_DELTA_PPM_PER_SEC=1.5
CRITICAL_GAS_THRESHOLD_PPM=100.0
TURBULENCE_VIBRATION_RMS_THRESHOLD=1.0
